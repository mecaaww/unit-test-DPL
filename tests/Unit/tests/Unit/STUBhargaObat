<?php

function hitungHargaSetelahDiskon(int $hargaAsli, int $diskonPersen): float
{
    return $hargaAsli - ($hargaAsli * ($diskonPersen / 100));
}

function hitungSubtotal(float $hargaSetelahDiskon, int $jumlah): float
{
    return $hargaSetelahDiskon * $jumlah;
}

function stubObat(int $harga, int $diskonPersen = 0): object
{
    return (object) [
        'harga' => $harga,
        'diskon_persen' => $diskonPersen
    ];
}

test('obat tanpa diskon', function () {

    $obat = stubObat(50000);

    $harga = hitungHargaSetelahDiskon(
        $obat->harga,
        $obat->diskon_persen
    );

    expect($harga)->toBe(50000.0);
});

test('obat diskon 10 persen', function () {

    $obat = stubObat(50000, 10);

    $harga = hitungHargaSetelahDiskon(
        $obat->harga,
        $obat->diskon_persen
    );

    expect($harga)->toBe(45000.0);
});

test('cek subtotal', function () {

    $subtotal = hitungSubtotal(15000, 3);

    expect($subtotal)->toBe(45000.0);
});
